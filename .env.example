# Copia este archivo a .env (el .env NO se sube al repo)
# Genera un secreto largo:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h
TENANTS=tenant_a,tenant_b,tenant_c
# true solo en dev: permite mandar "role" en /auth/register. En demo/prod dejar en false.
ALLOW_ROLE_ON_REGISTER=false
# Origen del front (URL de Amplify). Con * funciona para todo.
CORS_ORIGIN=*
